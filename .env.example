# Solo nombres. Los valores van en Vercel y en los secrets de Supabase (regla 6).
# En local, copia este archivo a apps/web/.env.local y llena los valores que imprime `supabase status`.

# Supabase: URL y clave publicable (antes "anon key"). Son públicas por diseño; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: clave secreta (antes "service role"). Solo en el servidor; salta RLS.
SUPABASE_SECRET_KEY=

# Push al barbero (F8). Claves VAPID: generarlas con
#   pnpm --filter @possos/notifications exec web-push generate-vapid-keys
# La pública puede ir al navegador; la privada solo en Vercel y en apps/web/.env.local.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Despacho de notificaciones (F8). La base lo manda en cada evento y cada minuto si algo quedó
# atrás. El mismo valor va en Supabase Vault como notifications_dispatch_secret.
# En local: solo-local-despacho (el de supabase/seed.sql).
CRON_SECRET=
