# Solo nombres. Los valores van en Vercel y en los secrets de Supabase (regla 6).
# En local, copia este archivo a apps/web/.env.local y llena los valores que imprime `supabase status`.

# Supabase: URL y clave publicable (antes "anon key"). Son públicas por diseño; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: clave secreta (antes "service role"). Solo en el servidor; salta RLS.
SUPABASE_SECRET_KEY=

# Push al barbero (F8). Claves VAPID: generarlas con
#   pnpm --filter @possos/notifications exec web-push generate-vapid-keys
# La pública puede ir al navegador; la privada solo en Vercel y en apps/web/.env.local.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Despacho de notificaciones (F8). La base lo manda en cada evento y cada minuto si algo quedó
# atrás. El mismo valor va en Supabase Vault como notifications_dispatch_secret.
# En local: solo-local-despacho (el de supabase/seed.sql).
CRON_SECRET=

# WhatsApp Cloud API de Meta (F7). Ver fases/F7-entrega.md. Sin WHATSAPP_ACCESS_TOKEN y
# WHATSAPP_PHONE_NUMBER_ID no se programa ni se manda nada; sin WHATSAPP_APP_SECRET y
# WHATSAPP_WEBHOOK_VERIFY_TOKEN el webhook responde 503.
# Token de acceso de un usuario del sistema del portafolio de negocio (permiso whatsapp_business_messaging).
WHATSAPP_ACCESS_TOKEN=
# Identificador del número en la Cloud API (WhatsApp Manager > API Setup). No es el número.
WHATSAPP_PHONE_NUMBER_ID=
# Secreto de la app de Meta (App settings > Basic): firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=
# Texto que se escribe en Meta al configurar el webhook (hub.verify_token). Generarlo con
#   openssl rand -hex 32
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Solo para pruebas: otra base de la Graph API (Playwright usa un servidor falso en
# http://127.0.0.1:3901). En producción va vacía y se usa https://graph.facebook.com/v24.0.
WHATSAPP_API_URL=
